# Used by `yarn build` (copy to .env.production.local, or pass these as environment variables).
# Relative API base: nginx proxies /api/ to the backend on the same origin.
REACT_APP_API_URL=/api
# Absolute URL of the player app (no trailing slash): fills og:image / og:url / canonical.
REACT_APP_SITE_URL=https://your-domain.com
